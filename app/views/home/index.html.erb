<div id="wrapper">

    <div id="popup" role="dialog" aria-modal="true" aria-labelledby="popup_title">
    <div id="popup_top">
      <div id="popup_title">
        <span id="suggestions_title"><%= t('suggestions') %></span>
        <span id="helper_title">Chutador</span>
      </div>
      <button type="button" id="close_popup" aria-label="<%= t('close') %>">X</button>
    </div>

    <div id="popup_bottom">
      <div id="loading" role="status"><%= t('loading')%></div>
      <div id="results" aria-live="polite">
        <%= t('number_of_suggestions_found') %>: <span id="count"></span>
        <div id="filter_word">
          <%= t('filter_word') %>: <button type="button" id="filter_word_button"></button>
          (<%= t('filter_word_remaining') %>: <span id="filter_word_remaining"></span>)
        </div>
        <ul id="legend">
          <li class="most_points"><%= t('legend_most_points') %></li>
          <li class="uncommon_letters"><%= t('legend_uncommon_letters') %></li>
          <li class="repeated_letters"><%= t('legend_repeated_letters') %></li>
          <li class="common_letters"><%= t('legend_common_letters') %></li>
        </ul>
        <div id="words"></div>
      </div>

      <div id="helper_content">
        <%= raw(t('intro')) %>
        <p>
          <a href="http://github.com/joaopribs/chutador" target="_blank">http://github.com/joaopribs/chutador</a><br/>
          <a href="mailto:joao@jpribeiro.com.br" target="_blank">joao@jpribeiro.com.br</a>
        </p>

        <p>
          <%= t('instructions_title') %>
        </p>

        <ul>
          <li>
            <%= t('instructions_intro') %>
          </li>
          <li>
            <%= t('instructions_letters_colors') %>
          </li>
          <li>
            <%= t('instructions_results') %><br/>
            <span class="most_points"><%= t('words_with_most_points') %></span><br/>
            <span class="uncommon_letters"><%= t('words_with_uncommon_letters') %></span><br/>
            <span class="repeated_letters"><%= t('words_with_repeated_letters') %></span><br/>
            <span class="common_letters"><%= t('words_with_most_common_letters') %></span>
          </li>
          <li>
            <%= t('instructions_filter_word') %>
          </li>
          <li>
            <%= t('instructions_desktop') %>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <button type="button" id="helper_link" aria-label="<%= t('help') %>">?</button>

  <div id="title">
    <img id="title_icon" src="/favicon.svg" alt="">
    Chutador
  </div>

  <div id="grid"
       data-empty="<%= t('grid_cell_empty') %>"
       data-black="<%= t('color_black') %>"
       data-yellow="<%= t('color_yellow') %>"
       data-green="<%= t('color_green') %>">
    <% 5.times do |row| %>
      <div class="grid_row">
        <% 5.times do |position| %>
          <button type="button" class="grid_cell transparent"
                  data-label="<%= t('grid_cell_label', row: row + 1, position: position + 1) %>"
                  aria-label="<%= t('grid_cell_label', row: row + 1, position: position + 1) %>: <%= t('grid_cell_empty') %>">&nbsp;</button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div id="color_hint"><%= t('color_hint') %></div>

  <div id="actions">
    <div id="flags">
      <%
        languages = {
          EN: ['🇺🇸', 'English'],
          PT: ['🇧🇷', 'Português']
        }

        languages.each do |key, (flag, name)|
          selected = I18n.locale.to_s.upcase == key.to_s
      %>
        <button type="button" class="language <%= selected ? "selected" : "" %>" data-language="<%= key %>" aria-label="<%= name %>" aria-pressed="<%= selected %>"><%= flag %></button>
      <% end %>
    </div>

    <div id="buttons">
      <button type="button" id="clear"><%= t('clear') %></button>
      <button type="button" id="search"><%= t('search') %></button>
    </div>
  </div>

  <div id="keyboard">
    <% ['QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM'].each_with_index do |row, index| %>
      <div class="keyboard_row">
        <% row.each_char do |letter| %>
          <button type="button" class="keyboard_cell" data-letter="<%= letter %>"><%= letter %></button>
        <% end %>
        <% if index == 2 %>
          <button type="button" class="keyboard_cell keyboard_cell_double" data-letter="delete" aria-label="<%= t('delete') %>">⌫</button>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
